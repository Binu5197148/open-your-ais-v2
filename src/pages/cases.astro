---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.noindex))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestHref = posts[0] ? `/blog/${posts[0].id}/` : '/blog/';

const cases = posts.filter((p) => (p.data.tags ?? []).includes('Case'));
const total = cases.length;

const fmtLong = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="Cases: AI Production Work That Shipped"
  description={`${total} finished projects built with AI production pipelines — films, campaigns and sites, with the method, the tools and what broke along the way.`}
  current="cases"
  latestHref={latestHref}
>
  <section class="container cs-head">
    <p class="mono" style="color:var(--c-accent)">§ — The work</p>
    <h1 class="cs-title" data-reveal="split">
      <span class="split-line">Cases,</span>
      <span class="split-line" style="--reveal-delay: 80ms"><em>what shipped.</em></span>
    </h1>
    <p class="cs-dek">
      Finished work, not concepts. Films, campaigns and sites made with AI
      inside a real production chain, each one opened up: the brief, the method,
      the tools that carried it, and the parts that broke before they worked.
    </p>
    <div class="cs-meta mono" data-reveal>
      <span>{total} {total === 1 ? 'case' : 'cases'}</span>
      <span>·</span>
      <span>Delivered work</span>
      <span>·</span>
      <span>Method included</span>
    </div>
  </section>

  <section class="container cs-grid-wrap">
    <div class="cs-grid">
      {cases.map((p) => (
        <a class="cs-card" href={`/blog/${p.id}/`}>
          {p.data.heroImage ? (
            <div class="cs-card__imgwrap">
              <img class="card__img" src={p.data.heroImage} alt="" loading="lazy" />
            </div>
          ) : null}
          <div class="cs-card__body">
            <p class="mono cs-card__date">{fmtLong(p.data.pubDate)}</p>
            <h2 class="cs-card__title">{p.data.title}</h2>
            <p class="cs-card__desc">{p.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .cs-head { margin-top: var(--s-9, 96px); }
  .cs-title {
    font-family: var(--font-serif);
    font-size: clamp(48px, 8vw, 110px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-weight: 400;
    margin: 18px 0 22px;
  }
  .cs-title em { font-style: italic; }
  .cs-dek {
    font-family: var(--font-serif);
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.45;
    max-width: 62ch;
    color: var(--c-fg-soft, var(--c-fg));
  }
  .cs-meta { display: flex; gap: 12px; margin-top: 22px; color: var(--c-fg-muted); }
  .cs-grid-wrap { margin: var(--s-8, 64px) 0 var(--s-9, 96px); }
  .cs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 28px;
  }
  .cs-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-top: 1px solid var(--c-rule);
    padding-top: 18px;
  }
  .cs-card__imgwrap { overflow: hidden; aspect-ratio: 16/10; }
  .cs-card__imgwrap img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s ease;
  }
  .cs-card:hover .cs-card__imgwrap img { transform: scale(1.04); }
  .cs-card__date { color: var(--c-fg-muted); margin-top: 14px; }
  .cs-card__title {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-weight: 400;
    margin: 8px 0 10px;
  }
  .cs-card__desc {
    font-size: 15px;
    line-height: 1.55;
    color: var(--c-fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
