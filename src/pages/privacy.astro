---
import BaseLayout from '../layouts/BaseLayout.astro';
const updated = 'September 28, 2026';
---

<BaseLayout title="Privacy Policy" description="Privacy policy for Open Your AIs.">
  <header class="container" style="padding-top: calc(var(--s-10) + 60px);">
    <p class="mono" style="color:var(--c-accent)">§ · Legal</p>
    <h1 style="font-family: var(--font-serif); font-size: clamp(48px, 7vw, 112px); letter-spacing: -0.035em; line-height: 0.95; margin-top: var(--s-6); font-weight: 400; max-width: 18ch;">
      Privacy Policy
    </h1>
    <p class="mono" style="margin-top: var(--s-5); color: var(--c-fg-muted);">Last updated: {updated}</p>
  </header>

  <section class="container" style="margin-top: var(--s-8);">
    <div class="prose">
      <p class="lead">
        Open Your AIs ("we", "our", "us") operates the website openyourais.com. This
        page informs you of our policies regarding the collection, use, and disclosure
        of personal information when you use our site.
      </p>
      <h2>Information we collect</h2>
      <p>
        We use Google Analytics to understand how visitors interact with the site.
        Analytics collects standard browsing data (pages viewed, device, country,
        referrer). Reports are aggregated, but the underlying collection can include
        online identifiers and device information. Aggregated reports do not mean
        that all data collected is anonymous.
      </p>
      <h2>Cookies</h2>
      <p>
        We use cookies for analytics and to serve advertising via Google AdSense.
        Third parties, including Google, use cookies to serve ads based on your
        prior visits to this and other websites. You can opt out of personalized
        advertising by visiting
        <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener">Google Ads Settings</a>.
      </p>
      <h2>Advertising</h2>
      <p>
        This site includes Google AdSense account verification code. Ad availability
        depends on Google approval and the ad configuration; this notice does not
        mean advertising is currently active. When ads are served, Google and its
        partners may process browsing information and use cookies. Learn more at the
        <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener">Google Partner Sites policy</a>.
      </p>
      <h2>External services and links</h2>
      <p>
        Fonts are requested from Google Fonts. Following a payment or affiliate
        link takes you to a separate provider with its own privacy policy.
        If you email us, we receive the information you choose to include so we
        can respond. Please do not send passwords or payment card information.
      </p>
      <h2>Your choices</h2>
      <p>
        You can control cookies in your browser and manage Google's advertising
        preferences through the link above. Contact us about your personal data
        or to request access, correction or deletion, subject to applicable law.
      </p>
      <h2>Contact</h2>
      <p>
        Questions? Email <a href="mailto:ulisses@openyourais.com">ulisses@openyourais.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
