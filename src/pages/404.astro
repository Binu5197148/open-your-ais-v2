---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page is no longer available. Explore the Open Your AIs archive or find a production workflow." noindex={true}>
  <main class="container missing-page">
    <p class="mono">404 · Page not found</p>
    <h1>This page<br /><em>isn't here.</em></h1>
    <p>The address may have changed, or this page is no longer published.</p>
    <nav aria-label="Continue reading">
      <a href="/blog/">Browse the dispatches →</a>
      <a href="/workflows/">Find a workflow →</a>
      <a href="/">Back to the index →</a>
    </nav>
  </main>
</BaseLayout>
<style>
  .missing-page { padding-block: var(--s-9, 96px); min-height: 65vh; }
  h1 { font-family: var(--font-serif); font-size: clamp(48px, 8vw, 100px); font-weight: 400; line-height: 1.05; margin-block: 24px; }
  p { max-width: 50ch; color: var(--c-fg-muted); line-height: 1.6; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 32px; }
  a { text-decoration: underline; text-underline-offset: 5px; }
</style>
