---
import { ADSENSE_CLIENT } from '../consts';
interface Props {
  slot: string;
  format?: string;
  responsive?: boolean;
}
const { slot, format = 'auto', responsive = true } = Astro.props;
---

<div class="adsense-slot">
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client={ADSENSE_CLIENT}
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive={responsive ? 'true' : 'false'}></ins>
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>

<style>
  /* The ad must never decide how wide the article column is. Full width
     responsive is off for the in-article slot (see BlogPost.astro): the ad
     script used to ask for the whole viewport and apply its own negative
     margins, which stretched the column and made every article scroll sideways
     on a phone. */
  .adsense-slot {
    max-width: 100%;
  }
</style>
